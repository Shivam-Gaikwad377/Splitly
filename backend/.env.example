

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=splitly
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-db-password

# JWT access tokens
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# Email verification and password reset
EMAIL_VERIFICATION_SECRET=replace-with-a-long-random-secret

# Brevo email provider
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=replace-with-your-verified-sender@example.com
BREVO_SENDER_NAME=Splitly

# Rate limiting
RATE_LIMIT_KEY_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_CLIENT_IP_SOURCE=socket